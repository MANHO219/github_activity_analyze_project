{
  "version": "ai_rules_v0.3.4.2",
  "engine": "v3",
  "status": "adopted_per_A_review",
  "supersedes": "ai_rules_v0.3.4.1",
  "updated_at_utc": "2026-11-10T05:40:00Z",
  "owner": "B",
  "changes_from_v0_1": [
    "裸 ai/ml 信号降为弱信号：单独出现不再直接 included，需要描述中的佐证词，否则记 uncertain（R4b/R5c）。",
    "新增课程作业识别 R3b：仓库名或描述含 course/final-project/assignment/openclassrooms 等。",
    "新增个人主页仓库识别 R3c：owner/repo 同名且描述与 topics 都为空。",
    "AI 关键词表拆分为 strong/weak 两组；加入佐证词表 corroboration_patterns。",
    "名称命中仍保留 uncertain（R6），因为名称不足以区分课程作业、个人项目与真实 AI 项目。"
  ],
  "open_questions": [
    "弱信号（裸 ai/ml）+ 非 AI 描述，是否应直接 excluded 而不是 uncertain？GROWI 案例。",
    "仅集成 AI 功能、主体非 AI 的项目是否纳入？v0.2 仍沿用 v0.1 的纳入口径，未单独排除。",
    "名称命中且描述为空的仓库是否允许抓 README 作为规则输入？v0.2 仍交给人工复核。"
  ],
  "scope": {
    "included": "仓库的 topic 或描述表明其核心用途是 AI/机器学习：模型、训练/推理、数据集与评测、AI 应用或 AI 工程工具。",
    "excluded": "命中资料集合、课程作业、个人主页仓库等排除模式；或元数据可读但没有任何 AI 信号。excluded 只表示“本轮规则未命中或明确不属于研究对象”，不是对仓库价值的判断。",
    "resource_collection": "awesome 列表、教程、课程资料、学习笔记、题库、链接合集一律排除。",
    "coursework": "学校课程、公开课、训练营作业采用同一标准排除，但必须确认是作业：仅命中 course、lab 等词不足以排除，需要明确的作业语义或描述佐证。",
    "profile_repository": "owner/repo 同名 + 无描述 + 无 topics + 无语言只算疑似个人主页，记 uncertain；README 明确是个人主页时才排除。",
    "ai_feature_only": "主体不是 AI、只附加 AI 功能（如 wiki 里的 AI 助手）的项目排除；以 AI 为核心功能的应用纳入，包括调用模型 API、不自己训练模型的应用。",
    "metadata_missing": "取不到元数据或返回 id 与 A 的 repo_id 不一致时，一律 uncertain。",
    "weak_signal": "裸 ai/ml 视为弱信号：单独出现维持 uncertain；描述里没有 AI 不代表一定不相关，只有明确证据表明不属于研究范围时才排除。",
    "readme_assist": "README 可作为辅助证据，优先用于描述缺失、名称命中或证据冲突的仓库；保存快照时间、哈希与判定依据，规则与人工标签都不被覆盖。"
  },
