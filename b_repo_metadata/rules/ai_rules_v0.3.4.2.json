    "ai_weak_patterns": [
      {
        "id": "ai_token",
        "regex": "\\bai\\b"
      },
      {
        "id": "ml_token",
        "regex": "\\bml\\b"
      }
    ],
    "min_weak_mentions": 3,
    "future_markers": [
      {
        "id": "future_plan",
        "regex": "\\b(plan|plans|planned|planning|will|future|roadmap|coming\\s+soon|intend|intends|todo|tbd)\\b|以后|计划|打算|未来|即将|待定"
      }
    ],
    "project_sections": [
      {
        "id": "engineering_section",
        "regex": "(?im)^#{1,4}\\s*(install|installation|setup|usage|quick\\s*start|getting\\s*started|features|api|configuration|config|build|examples?|tests?)\\b|```"
      }
    ],
    "non_ai": {
      "rule_id": "R12_readme_non_ai",
      "min_meaningful_chars": 200,
      "note": "README 去链接/图片/HTML 后的有效字符数达到阈值，且 AI 强/弱证据为 0，才排除；只命中用途标题时，标题下方必须有说明正文。",
      "require_purpose": true,
      "allowed_base_rules": [
        "R7_insufficient_text_evidence"
      ],
      "purpose_patterns": [
        {
          "id": "purpose_heading",
          "regex": "(?im)^#{1,4}\\s*(about|overview|description|introduction|what\\s+is|features)\\b"
        },
        {
          "id": "purpose_sentence",
          "regex": "\\bthis\\s+(project|repository|repo|library|tool|app|package)\\s+is\\b|\\bis\\s+(a|an)\\s+[^.\\n]{0,60}\\b(library|tool|application|app|framework|package|platform|engine|game|website|service|bot|player|editor|client|server|system)\\b"
        },
        {
          "id": "purpose_zh",
          "regex": "本项目|这是一个|主要功能|用于"
        }
      ],
      "template_patterns": [
        {
          "id": "template",
          "regex": "\\bbootstrapped\\s+with\\b|\\bcreate-next-app\\b|\\bcreate-react-app\\b|\\bcreate-vite\\b|\\bstarter\\s+template\\b|\\bboilerplate\\b|\\btemplate\\s+repository\\b|\\bthis\\s+is\\s+a\\s+next\\.js\\s+project\\b"
        }
      ],
      "purpose_requires_body": true,
      "min_purpose_body_chars": 40,
      "ignore_install_lines": true
    },
    "feature_only_patterns": [
      {
        "id": "with_ai_feature",
        "regex": "\\bwith\\s+(an?\\s+)?ai\\s+(assistant|assistants|feature|features|plugin|integration|chat|chatbot)\\b"
      },
      {
        "id": "ai_feature_for",
        "regex": "\\bai\\s+(assistant|feature|features|plugin|add[-\\s]?on|integration)\\s+(for|in|on)\\b"
      },
      {
        "id": "optional_ai",
        "regex": "\\b(optional|built[-\\s]?in|integrated)\\s+ai\\b"
      },
      {
        "id": "integrates_ai",
        "regex": "\\bintegrates?\\s+(with\\s+)?(openai|chatgpt|gpt|llm|ai)\\b"
      },
      {
        "id": "optional_integration",
        "regex": "\\boptional(ly)?\\b[^.\\n]{0,40}\\b(chatgpt|openai|gpt|llm|ai)\\b"
      },
      {
        "id": "integration_optional",
        "regex": "\\b(chatgpt|openai|gpt|llm|ai)\\b[^.\\n]{0,40}\\boptional(ly)?\\b"
      },
      {
        "id": "can_integrate",
        "regex": "\\bcan\\s+(optionally\\s+)?(integrate|connect|use)\\b[^.\\n]{0,40}\\b(chatgpt|openai|llm|ai)\\b"
      }
    ],
    "course_override": {
      "rule_id": "R13_course_override",
      "enabled": true,
      "positive_patterns": [
        {
          "id": "made_for_course",
          "regex": "\\b(made|created|built|developed|written|prepared|coded)\\b[^.\\n]{0,40}\\b(for|as\\s+part\\s+of|during)\\b[^.\\n]{0,60}\\b(course|bootcamp|class|program|training)\\b"
        },
        {
          "id": "course_project",
          "regex": "\\b(course|bootcamp)\\s+(project|assignment|work|material|exercise)s?\\b"
        },
        {
          "id": "zh_course_project",
          "regex": "为.{0,20}(课程|训练营).{0,12}(制作|开发|完成)|课程项目|训练营作业|课程作业"
        }
      ],
      "negative_patterns": [
        {
          "id": "author_attended",
          "regex": "\\b(attended|participated|participant|graduated|graduate\\s+of|student\\s+at|alumnus|alumni)\\b[^.\\n]{0,40}\\b(course|bootcamp|class|program)\\b"
        },
        {
          "id": "teaching_example",
          "regex": "\\bused\\s+(as|for)\\s+(a\\s+)?(teaching|course|class)\\s+(example|material)s?\\b|\\bteaching\\s+example\\b|\\bcourse\\s+example\\b"
        },
        {
          "id": "inspired_by_course",
          "regex": "\\binspired\\s+by\\b[^.\\n]{0,40}\\b(course|bootcamp|class)\\b"
        }
      ]
    }
  },
  "changes_from_v0_3": [
    "README 判 AI 收紧：只有强 AI 证据，或弱词出现至少 3 次且伴随佐证词时才纳入；含“计划/以后/roadmap”等字样的行先剔除，避免“以后打算加 AI”被算作 AI 项目。",
    "README 判个人主页收紧：只有规则已判为个人主页疑似（同名 + 无描述 + 无 topics + 无语言）时，才用 README 确认；且 README 不能有 Install/Usage/Features/API 等工程章节，避免把 ML 项目的作者介绍当成个人主页。"
  ],
  "changes_from_v0_3_1": [
    "名称命中加入词边界，并把 camelCase 拆成带分隔符的小写形式：ResnetGPT 能命中 gpt，Whispering 不会被当成 whisper。",
    "中英相邻处先插入空格再匹配：修复“用Resnet101+GPT搭建…的AI”因为中文里 \\b 失效而被漏判的问题。"
  ],
  "changes_from_v0_3_2": [
    "新增 R12_readme_non_ai：当规则判 uncertain、README 有足够正文（>=200 个有效字符）且完全没有 AI 证据、没有课程/个人主页证据时，按“README 确认主体非 AI”排除。",
    "新规则只用于 README 证据充分且无冲突的情况：短 README、只有标题或只有链接的，仍维持 uncertain。",
    "测试案例：CoreELEC/xbmc（Kodi 影音中心）应由 uncertain 改为 excluded；Etherscan-ML 由人工按训练营项目标为 excluded。"
  ],
  "changes_from_v0_3_3": [
    "R12 收紧：必须能从 README 找到项目主要用途（About/Overview 标题或“X is a …”式说明），模板/脚手架/只有安装说明的 README 不排除。",
    "R12 只对 R7（描述与 topics 都为空）生效；名称命中（R6）或弱信号（R4b/R5c）属于冲突证据，继续 uncertain。",
    "R12 只在规则文件显式配置 readme_rules.non_ai 时启用；v0.3.2 及更早版本没有该配置，加载后不会触发 R12，保证版本对比可复现。"
  ],
  "changes_from_v0_3_3_1": [
    "可选 AI 集成不作为纳入依据：描述或 README 明确写 optional ChatGPT/OpenAI 集成时判 excluded（R5d），以 AI 助手为核心的应用仍 included。",
    "新增 R13_course_override：README 明确说明仓库是为课程/训练营制作时，可把 included 覆盖为 excluded；只提到作者参加过训练营、或曾被用作教学示例的，维持原标签。",
    "两个新行为都只在规则文件显式配置时启用，旧版本规则文件行为不变。"
  ],
  "changes_from_v0_3_4": [
    "R12 收紧用途判定：只命中 About/Overview/Description 等标题不再算“README 说明了项目用途”，标题下方必须有真正的说明正文（>=40 个有效字符）。",
    "空 Overview 标题 + 安装命令、代码块、徽章/链接都不计入正文；安装步骤 README 维持 uncertain，CoreELEC/xbmc 这类明确写出项目用途的仍排除。",
    "新行为只在规则文件配置 readme_rules.non_ai.purpose_requires_body 时启用，v0.3.4 及更早版本加载后行为不变。"
  ],
  "changes_from_v0_3_4_1": [
    "R12 的“说明正文”排除英文安装说明：Overview 下只有 Install/Run/Setup 等指令行、或以冒号收尾的引导句时，不再算项目用途。",
    "对照案例：空/仅安装说明的 Overview 维持 uncertain；CoreELEC/Kodi 式用途说明仍 excluded。",
    "新行为只在本版启用，v0.3.4.1 及更早版本行为不变。"
  ]
}
